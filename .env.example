# ==============================================================================
# Vercel / 서버리스 환경 변수 설정 예시
# ==============================================================================
# 주의:
# 1. 이 파일(.env.example)에는 실제 키 값을 넣지 마세요.
# 2. 로컬 테스트 시에는 .env 파일을 생성해 값을 넣고,
#    Vercel 배포 시에는 Vercel Dashboard > Project Settings > Environment Variables에 등록하세요.
# ==============================================================================

# [필수 - 서버 전용] Google Gemini API 키
# - 절대로 VITE_ 접두사를 붙이지 마세요! (브라우저 번들에 노출되면 안 됩니다)
# - api/recommend.ts(Vercel Serverless Function) 및 server.ts의 process.env.GEMINI_API_KEY로 읽습니다.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# [선택 - 서버 전용] CORS 허용 도메인 (쉼표로 여러 도메인 구분 가능)
# - 비워 두거나 '*'로 두면 모든 Origin 허용, 특정 도메인만 허용하려면 예: https://your-app.vercel.app
ALLOWED_ORIGIN="*"

# [선택 - 클라이언트 전용] API 서버 기본 URL
# - 프론트엔드와 /api 서버리스 함수를 같은 Vercel 프로젝트에 배포할 때는 비워 두세요(상대 경로 '/api/*' 사용).
# - 별도 도메인의 백엔드를 호출할 때만 https://your-api.vercel.app 처럼 지정하세요.
VITE_API_BASE_URL=""

# [선택] 호스팅 URL (AI Studio / OAuth 등 자체 참조 URL 필요 시)
APP_URL="http://localhost:3000"
